# GEMINI_API_KEY: Required for Gemini AI API calls in the Android module.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Web app Supabase configuration (provided by the connected integration).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Server-only key used by the administrator media upload route. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
